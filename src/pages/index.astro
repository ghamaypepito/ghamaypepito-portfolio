---
import { SITE } from '@/content/site';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/astro/Hero.astro';
import Manifesto from '@/components/astro/Manifesto.astro';
import Services from '@/components/astro/Services.astro';
import FeaturedWork from '@/components/astro/FeaturedWork.astro';
import Workflow from '@/components/astro/Workflow.astro';
import WebApps from '@/components/astro/WebApps.astro';
import AiPractice from '@/components/astro/AiPractice.astro';
import GoHighLevel from '@/components/astro/GoHighLevel.astro';
import Experience from '@/components/astro/Experience.astro';
import Skills from '@/components/astro/Skills.astro';
import Quotes from '@/components/astro/Quotes.astro';
import Contact from '@/components/astro/Contact.astro';
import Footer from '@/components/astro/Footer.astro';
import FloatingNav from '@/components/react/FloatingNav';

const title = 'Ghamay Pepito — Website Designer, Developer & Digital Marketer';
const description =
  `Portfolio of Emeterio 'Ghamay' Pepito III — Website Designer & Developer, Digital Marketing Manager and SEO Specialist in Cebu City. Web apps, AI-assisted marketing systems, GoHighLevel implementation, and ${SITE.projects.length} live projects.`;
---
<Base title={title} description={description}>
  <FloatingNav client:idle pathname={Astro.url.pathname} />
  <main>
    <Hero />
    <Manifesto />
    <Services />
    <FeaturedWork />
    <WebApps />
    <AiPractice />
    <Workflow />
    <GoHighLevel />
    <Experience />
    <Skills />
    <Quotes />
    <Contact />
  </main>
  <Footer />
</Base>
