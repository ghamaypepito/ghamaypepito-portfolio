---
import { BRAND_MARK } from '@/lib/icons';

interface Props { size?: number; class?: string; }
const { size = 34, class: klass } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 34 34"
  fill="none"
  class={klass}
  style="color: var(--accent)"
  aria-hidden="true"
  focusable="false"
  set:html={BRAND_MARK}
/>
