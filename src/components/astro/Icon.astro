---
import { ICON_PATHS, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 22, stroke = 1.6, class: klass } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klass}
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
