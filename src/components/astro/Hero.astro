---
import { Image } from 'astro:assets';
import { SITE } from '@/content/site';
import Kicker from './Kicker.astro';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import portrait from '@/assets/portrait-hero.jpg';

const nameLines = ['Ghamay', 'Pepito'];
---
<header class="hero" id="top">
  <div class="aurora" aria-hidden="true"><span></span><span></span></div>
  <div class="grain" aria-hidden="true"></div>

  <nav class="nav" aria-label="Primary">
    <a href="#top" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark"><BrandMark size={34} /></span>
    </a>
    <div class="nav-links">
      <a href="#work" class="nav-link is-active">Work</a>
      <a href="#services" class="nav-link">Services</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>
  </nav>

  <div class="hero-grid">
    <div class="hero-left">
      <h1 class="hero-name">
        {nameLines.map((line, i) => (
          <span class="hn">
            <span class="hn-mask">
              <span style={`--d: ${120 + i * 90}ms`}>
                {line}{i === nameLines.length - 1 && <span class="dot">.</span>}
              </span>
            </span>
          </span>
        ))}
      </h1>

      <span class="hero-underline" aria-hidden="true"></span>

      <div class="hero-socials">
        {SITE.socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noreferrer noopener"
            class="soc"
            aria-label={`${SITE.name} on ${s.label}`}
          >
            <span aria-hidden="true">{s.short}</span>
          </a>
        ))}
      </div>

      <div class="hero-portrait">
        <Image
          src={portrait}
          alt={`Portrait of ${SITE.fullName}`}
          widths={[420, 840]}
          sizes="(max-width: 980px) 100vw, 420px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-intro">
        <Kicker>Introduction</Kicker>
        <p class="hero-tagline">
          {SITE.taglineLead} <em>{SITE.taglineEmph}</em> {SITE.taglineTail}
        </p>
        <p class="hero-blurb">{SITE.intro}</p>
        <a href="#work" class="link-arrow">
          My work <Icon name="arrow" size={17} />
        </a>
      </div>

      <div class="hero-rolerow">
        {SITE.roles.map((r, i) => (
          <>
            {i > 0 && <span class="role-sep" aria-hidden="true"></span>}
            <span class="role">{r}</span>
          </>
        ))}
      </div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span>Scroll</span>
    <span class="scroll-line"></span>
  </div>
</header>
