{
  "name": "ghamaypepito-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Emeterio 'Ghamay' Pepito III — Website Designer & Developer, Digital Marketing Manager, SEO Specialist.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p functions/tsconfig.json && astro build",
    "build:fast": "astro build",
    "preview": "astro preview",
    "shots": "node scripts/capture-shots.mjs",
    "shots:optimize": "node scripts/optimize-shots.mjs",
    "og": "node scripts/generate-og.mjs",
    "deploy": "wrangler pages deploy dist --project-name=ghamaypepito-portfolio",
    "typecheck": "astro check && tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.3.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "lightningcss": "^1.33.0",
    "playwright": "^1.50.1",
    "satori": "^0.12.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0",
    "wrangler": "^4.0.0"
  }
}
